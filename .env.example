PORT=3000
NODE_ENV=development

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=ansim
DATABASE_PASSWORD=ansim
DATABASE_NAME=ansim

# Google OAuth
GOOGLE_CLIENT_ID=your-web-app-client-id.apps.googleusercontent.com

# JWT
JWT_SECRET=your-long-random-secret-key
JWT_REFRESH_SECRET=your-another-long-random-secret-key
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

# GCP Cloud Storage
GCP_PROJECT_ID=your-gcp-project-id
GCS_BUCKET_NAME=your-bucket-name
GCS_KEY_FILE_PATH=./gcp-service-account-key.json
GCS_SIGNED_URL_EXPIRATION=15
